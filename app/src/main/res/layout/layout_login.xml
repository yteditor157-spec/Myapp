<?xml version="1.0" encoding="utf-8"?>
<!-- SMS READER • com.ishan.sms • © Ishan -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="28dp"
        android:paddingEnd="28dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="SMS READER"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SMS READER"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="অ্যাডমিন প্যানেল থেকে পাওয়া Key দিয়ে লগইন করুন"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_input"
            android:hint="RH-XXXXX-XXXXX-XXXXX-XXXXX"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="#A9A4C4"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/purple"
            android:text="লগইন"
            android:textSize="16sp"
            app:cornerRadius="18dp" />

        <TextView
            android:id="@+id/tvLoginMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#C2255C"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.ishan.sms.BrandFooterView
            android:id="@+id/brandLogin"
            android:layout_width="match_parent"
            android:layout_height="34dp" />
    </LinearLayout>
</ScrollView>
